package querywire

import (
	"log"

	ydb "github.com/ydb-platform/ydb-go-sdk/v3"
)

// Option keeps older SDK baselines on their standard protobuf decoder.
func Option(enabled bool) ydb.Option {
	if enabled {
		log.Print("query-proto-wire-decoding is unavailable in this SDK baseline; using standard protobuf decoding")
	}

	return ydb.With()
}
